# =====================================================================
# DigiSecure - Variables de entorno (PLANTILLA)
# =====================================================================
# Copiar a .env y completar con valores reales.
# NUNCA versionar el archivo .env real.
# =====================================================================

# --- Aplicación ---
APP_NAME="DigiSecure"
APP_ENV=production                 # development | qa | production
APP_DEBUG=false                    # SIEMPRE false en produccion
APP_URL=https://digisecure.digitech.com.ec
APP_TIMEZONE=America/Guayaquil
APP_LOCALE=es_EC

# --- Base de datos (MySQL 8.0+) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Sesiones ---
SESSION_NAME=DIGISECURE_SID
SESSION_LIFETIME_MINUTES=120       # Idle timeout
SESSION_COOKIE_SECURE=true         # true en produccion (HTTPS)
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict
SESSION_SAVE_PATH=var/sessions

# --- Cifrado / claves maestras ---
# Generar con: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
# Clave maestra para cifrado AES-256-GCM de datos sensibles (cédulas, cuentas, archivos)
ENCRYPTION_KEY=

# --- Hashing de contraseñas (Argon2id) ---
PASSWORD_ALGO=argon2id
PASSWORD_MEMORY_COST=65536         # 64 MB
PASSWORD_TIME_COST=4
PASSWORD_THREADS=2

# --- Almacenamiento de archivos ---
STORAGE_PATH=var/storage           # Fuera del webroot
STORAGE_MAX_FILE_MB=10
STORAGE_MAX_EXPEDIENTE_MB=500

# --- Email (PHPMailer / SMTP) ---
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls                # tls | ssl
MAIL_FROM_ADDRESS=no-reply@digisecure.ec
MAIL_FROM_NAME="DigiSecure"

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_DRIVER=meta_cloud
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TIMEOUT_SECONDS=15

# --- Google Maps (Croquis) ---
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_DEFAULT_LAT=-0.1807
GOOGLE_MAPS_DEFAULT_LNG=-78.4678
GOOGLE_MAPS_DEFAULT_ZOOM=15

# --- Logging ---
LOG_CHANNEL=file
LOG_PATH=var/logs/digisecure.log
LOG_LEVEL=error                    # debug | info | warning | error

# --- Seguridad / Rate limiting ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
CSRF_TOKEN_LIFETIME_MINUTES=120
SECURE_URL_TTL_SECONDS=900        # Tokens URL AES-GCM ligados a sesion

# --- LOPDP / Retención de datos ---
LOPDP_RETENTION_YEARS=5
LOPDP_LEGAL_TEXT_VERSION=1.0

# --- Notificaciones de vencimientos ---
NOTIFY_DAYS_BEFORE_EXPIRY=30,15,7
