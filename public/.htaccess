# =====================================================================
# DigiSecure - Apache rewrite rules (front controller)
# =====================================================================
# Todas las peticiones se enrutan a public/index.php.
# Los archivos físicamente existentes (CSS, JS, imágenes) se sirven directo.
# =====================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acceso directo a archivos sensibles
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^\.git - [F,L]

    # Si el archivo o directorio NO existe, redirigir a index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# --- Headers de seguridad ---
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # En producción descomentar (requiere HTTPS):
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Deshabilitar listado de directorios
Options -Indexes
