{
    "name": "digisecure/digisecure",
    "description": "DigiSecure - Sistema Integral SaaS multi-tenant para administración de fichas y documentación de guardias de seguridad. Desarrollado en PHP 8.2+ vanilla.",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.31"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "DigiSecure\\Kernel\\": "src/Kernel/",
            "DigiSecure\\Shared\\": "src/Shared/",
            "DigiSecure\\Security\\": "src/Security/",
            "DigiSecure\\Tenant\\": "src/Tenant/",
            "DigiSecure\\User\\": "src/User/",
            "DigiSecure\\Ficha\\": "src/Ficha/",
            "DigiSecure\\Expediente\\": "src/Expediente/",
            "DigiSecure\\Notification\\": "src/Notification/",
            "DigiSecure\\Subscription\\": "src/Subscription/",
            "DigiSecure\\Reporting\\": "src/Reporting/",
            "DigiSecure\\Infrastructure\\": "src/Infrastructure/",
            "DigiSecure\\Superadmin\\": "src/Superadmin/",
            "DigiSecure\\Cliente\\": "src/Cliente/",
            "DigiSecure\\Puesto\\": "src/Puesto/",
            "DigiSecure\\Asignacion\\": "src/Asignacion/",
            "DigiSecure\\Aspirante\\": "src/Aspirante/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DigiSecure\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "stan": "phpstan analyse src --level=8"
    }
}
