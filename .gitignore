# =====================================================================
# DigiSecure - .gitignore
# =====================================================================

# --- Composer ---
composer.phar
composer.lock.bak

# --- Variables de entorno (NUNCA versionar) ---
.env
.env.local
.env.*.local
.env.production
.env.staging

# --- Archivos generados / runtime ---
/var/cache/*
!/var/cache/.gitkeep
/var/logs/*
!/var/logs/.gitkeep
/var/sessions/*
!/var/sessions/.gitkeep
/var/storage/*
!/var/storage/.gitkeep
/var/imports/*
!/var/imports/.gitkeep

# --- IDEs / Editores ---
/.idea/
/.vscode/
/.claude/
/.agents/
/.codex/
*.swp
*.swo
*~
.project
.settings/
.buildpath
*.sublime-workspace
*.sublime-project

# --- Sistema operativo ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.AppleDouble
.LSOverride
$RECYCLE.BIN/

# --- PHPUnit / Tests ---
/.phpunit.cache/
.phpunit.result.cache
/coverage/
/build/

# --- PHPStan ---
/.phpstan.cache/
phpstan.neon.local

# --- Logs sueltos ---
*.log
tmp_*.txt
/var/*.txt

# --- Backups ---
*.bak
*.backup
*.old

# --- Archivos sensibles ---
*.pem
*.key
*.crt
*.p12
*.pfx
*.xls
*.xlsx
*.csv
*.sql.gz
*.sql.zip
*_dump.sql
*_backup.sql

# --- Scripts SQL de base de datos: NUNCA versionar ---
# Solo las migraciones viajan en git (bin/migrate.php las necesita en el
# servidor). Scripts para phpMyAdmin, respaldos y diagnosticos quedan locales.
*.sql
!/migrations/*.sql
secrets/
private/

# --- Herramientas de desarrollo (phpunit/phpstan) fuera de vendor/ versionado ---
/.devtools/
/var/.phpunit.cache/
